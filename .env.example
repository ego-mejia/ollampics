# Ollama
OLLAMA_HOST=http://localhost:11434

# Database
OLLYMPICS_DB_URL=sqlite:///./data/ollympics.db

# Judge externo (opcional — solo para suites con llm_judge)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# LLM provider para agentes de generación (corpus sintético, etc.).
# Cualquier proveedor compatible con OpenAI API.
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1

# Tasks directory
OLLYMPICS_TASKS_DIR=./tasks
